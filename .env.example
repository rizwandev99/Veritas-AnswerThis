# ==============================================================================
# Veritas — Environment Configuration Template
# Copy this file to .env before starting services
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Persistence Configuration (Neon Postgres / pgvector)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=veritas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# In Docker: postgresql://postgres:postgres@postgres:5432/veritas
# Locally:   postgresql://postgres:postgres@localhost:5432/veritas
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veritas

# Vector Store Backend: "pgvector" (production) or "faiss" (in-memory offline testing)
VECTOR_STORE_BACKEND=pgvector

# ------------------------------------------------------------------------------
# 2. FastAPI Backend Server Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PORT=8000
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_HOURLY_REVIEW_LIMIT=5

# ------------------------------------------------------------------------------
# 3. Next.js Frontend Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
WEB_PORT=3000

# ------------------------------------------------------------------------------
# 4. External Paper Providers (100% Free Tiers)
# ------------------------------------------------------------------------------
# OpenAlex requires a polite pool email address in the User-Agent / mailto parameter
OPENALEX_MAILTO=team@veritas.local

# Optional secondary provider (free tier)
SEMANTIC_SCHOLAR_API_KEY=

# ------------------------------------------------------------------------------
# 5. LLM & Embeddings Providers (100% Free Tiers)
# ------------------------------------------------------------------------------
# Google AI Studio Free Tier (Gemini 1.5 Flash & text-embedding-004)
GEMINI_API_KEY=

# Optional fallback LLM provider (free tier)
GROQ_API_KEY=

# Providers selection:
# LLM_PROVIDER: "gemini", "groq", or "mock" (offline testing)
LLM_PROVIDER=gemini

# EMBEDDING_PROVIDER: "fastembed" (local zero-network), "gemini", or "fake"
EMBEDDING_PROVIDER=fastembed
